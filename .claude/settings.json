{
  "permissions": {
    "allow": [
      "Bash(./.venv/*/python* -m dev_lab.dev.verify *)",
      "Bash(.venv/*/python* *)",
      "Bash(.venv/*/python* -m dev_lab.dev.verify *)",
      "Bash(.venv/*/python* -m dev_lab.dev.branchset *)",
      "Bash(.venv/*/python* -m dev_lab.dev.worktrees *)",
      "Bash(.venv/*/python* -m dev_lab.dev.stoprun *)",
      "Bash(.venv/*/python* -m dev_lab.dev.netverb *)",
      "Bash(.venv/*/python* -m dev_lab.dev.famfiles *)",
      "Bash(.venv/*/python* -m dev_lab.dev.autodoors *)",
      "Bash(.venv/Scripts/python.exe -m dev_lab.dev.dep --bootstrap *)",
      "Bash(.venv/bin/python -m dev_lab.dev.dep --bootstrap *)",
      "Bash(./.venv/Scripts/python.exe -m dev_lab.dev.dep --bootstrap *)",
      "Bash(./.venv/bin/python -m dev_lab.dev.dep --bootstrap *)",
      "Bash(.claude/worktrees/*/.venv/Scripts/python.exe -m dev_lab.dev.dep --bootstrap *)",
      "Bash(.claude/worktrees/*/.venv/bin/python -m dev_lab.dev.dep --bootstrap *)",
      "Bash(.venv/Scripts/python.exe scripts/deny_rules.py *)",
      "Bash(.venv/bin/python scripts/deny_rules.py *)",
      "Bash(./.venv/Scripts/python.exe scripts/deny_rules.py *)",
      "Bash(./.venv/bin/python scripts/deny_rules.py *)",
      "Bash(.claude/worktrees/*/.venv/Scripts/python.exe scripts/deny_rules.py *)",
      "Bash(.claude/worktrees/*/.venv/bin/python scripts/deny_rules.py *)",
      "Bash(.venv/Scripts/python.exe scripts/dep.py *)",
      "Bash(.venv/bin/python scripts/dep.py *)",
      "Bash(./.venv/Scripts/python.exe scripts/dep.py *)",
      "Bash(./.venv/bin/python scripts/dep.py *)",
      "Bash(.claude/worktrees/*/.venv/Scripts/python.exe scripts/dep.py *)",
      "Bash(.claude/worktrees/*/.venv/bin/python scripts/dep.py *)",
      "Bash(.venv/Scripts/python.exe scripts/pdoc.py *)",
      "Bash(.venv/bin/python scripts/pdoc.py *)",
      "Bash(./.venv/Scripts/python.exe scripts/pdoc.py *)",
      "Bash(./.venv/bin/python scripts/pdoc.py *)",
      "Bash(.claude/worktrees/*/.venv/Scripts/python.exe scripts/pdoc.py *)",
      "Bash(.claude/worktrees/*/.venv/bin/python scripts/pdoc.py *)",
      "Bash(.venv/*/python* -m dev_lab.dev.hpchost deploy-fleet *)",
      "Bash(.venv/*/python* -m dev_lab.dev.forge cancel-stuck *)",
      "Bash(.venv/*/python* -m dev_lab.dev.forge watch *)",
      "Bash(.venv/*/python* -m dev_lab.dev.forge pr close-landed *)",
      "Bash(.venv/*/python* -m dev_lab.dev.forge pr close-superseded *)",
      "Bash(.venv/*/python* -m dev_lab.dev.branchprune delete *)",
      "Bash(git merge --ff-only *)",
      "Bash(git -C * merge --ff-only *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "e=\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-commands.js\"; [ -f \"$e\" ] || { echo \"agent-guard: no engine at $e -- refused (fail closed); re-install: python -m dev_lab.dev.hook_install --install\" >&2; exit 2; }; node \"$e\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-rules.json\" || { echo \"agent-guard: the engine exited $? -- refused (fail closed)\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.codeplace stray"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.js\" -m dev_lab.dev.codeplace stray"
          }
        ]
      }
    ]
  }
}
