
{
  "permissions": {
    "allow": [
      "Bash(./.venv/Scripts/python.exe -m lab_commons.dev.verify *)",
      "Bash(./.venv/Scripts/python.exe scripts/dep.py *)",
      "Bash(uv run python -m optimi_lab*)",
      "Bash(uv sync --extra *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/deny-commands.js .claude/hooks/deny-rules.json"
          }
        ]
      }
    ]
  }
}
